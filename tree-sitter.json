{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "qbe",
      "camelcase": "QBE",
      "title": "QBE",
      "scope": "source.ssa",
      "file-types": [
        "ssa",
        "qbe"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^qbe$",
      "class-name": "TreeSitterQbe"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter parser for QBE Intermediate Language.",
    "authors": [
      {
        "name": "Robin Wyllie"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-qbe"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
